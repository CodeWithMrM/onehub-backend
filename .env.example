# ─── Database (Neon PostgreSQL) ─────────────────────────────────
# Pooled connection string (used at runtime by the app).
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/onehub?sslmode=require
# Direct (non-pooled) connection string, required by Prisma migrations.
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/onehub?sslmode=require

# ─── Clerk ───────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_placeholder_replace_me
# The issuer for your Clerk instance, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER=https://placeholder.clerk.accounts.dev

# ─── Redis (rate limiting) ──────────────────────────────────────
# Optional locally — falls back to an in-memory limiter if unset
# or unreachable. Required in production for limits to be shared
# across worker processes.
REDIS_URL=redis://localhost:6379/0

# ─── App ─────────────────────────────────────────────────────────
ENVIRONMENT=development

# Comma-separated list of allowed origins, e.g.
# http://localhost:5173,http://localhost:5174,https://onehub-web.example.com,https://onehub-admin.example.com
# (5173 = customer web app dev server, 5174 = admin dashboard dev server)
CORS_ORIGINS=

# Optional: seeds a local admin StoreMember for this Clerk user id
# when running prisma/seed.py. Never used in production.
DEV_ADMIN_CLERK_USER_ID=
